{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "WorldFate: 자동 배포",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\auto-publish.ps1"
      ],
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "worldfate-auto-publish",
          "pattern": {
            "regexp": "^$"
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^Starting WorldFate auto-publisher$",
            "endsPattern": "^READY: WorldFate auto-publisher is watching files$"
          }
        }
      ],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
